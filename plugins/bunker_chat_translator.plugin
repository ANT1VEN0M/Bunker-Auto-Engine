SUPPORTED_LANGUAGES: List[Tuple[str, str]] = [
    ("Русский", "ru"),
    ("English", "en"),
    ("Deutsch", "de"),
    ("Español", "es"),
    ("Français", "fr"),
    ("Italiano", "it"),
