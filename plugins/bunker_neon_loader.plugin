def _log(msg: str):
    try:
        log(f"[BunkerLoader] {msg}")
    except Exception:
        pass


def safe_notify(msg: str):
    """Отображает всплывающее уведомление (Toast) на главном UI-потоке."""
    try:
        def _toast():
            try:
                ctx = ApplicationLoader.applicationContext
                if ctx:
                    Toast.makeText(ctx, str(msg), Toast.LENGTH_SHORT).show()
            except Exception:
                pass
        run_on_ui_thread(_toast)
    except Exception:
        _log(f"Notify: {msg}")


def _to_signed_32(val: int) -> int:
    """Преобразует 32-битное число в знаковый int для Java/Android."""
    val = val & 0xFFFFFFFF
    if val >= 0x80000000:
        val -= 0x100000000
    return int(val)


def _hsv_to_argb(h: float, s: float, v: float, a: int = 255) -> int:
    """Чистый генератор ARGB цвета из HSV без зависимости от сторонних библиотек."""
    h = (float(h) % 360.0) / 60.0
    i = int(h)
    f = h - i
    p = v * (1.0 - s)
    q = v * (1.0 - s * f)
    t = v * (1.0 - s * (1.0 - f))

    if i == 0:
        r, g, b = v, t, p
    elif i == 1:
        r, g, b = q, v, p
    elif i == 2:
        r, g, b = p, v, t
    elif i == 3:
        r, g, b = p, q, v
    elif i == 4:
        r, g, b = t, p, v
    else:
        r, g, b = v, p, q

    ir = int(r * 255.0) & 0xFF
    ig = int(g * 255.0) & 0xFF
    ib = int(b * 255.0) & 0xFF
    ia = int(a) & 0xFF

    raw = (ia << 24) | (ir << 16) | (ig << 8) | ib
    return _to_signed_32(raw)


# ==============================================================================
# ХУКИ ДЛЯ RadialProgress2 (Основной лоадер ChatMessageCell: фото, видео, кружки)
# ==============================================================================

class RadialProgress2DrawHook(MethodHook):
    """
    Перехватывает RadialProgress2.draw(Canvas).
    Критически важно: вызываем setColors(backdrop, backdrop, color, color) перед отрисовкой,
    чтобы сбросить circleColorKey = -1 и iconColorKey = -1. Это предотвращает перезапись
    цветов стандартной темой Telegram.
    """

    def __init__(self, plugin: "BunkerNeonLoaderPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.is_enabled():
            return
        try:
            rp2 = param.thisObject
            if rp2 is None:
                return

            color = self.plugin.get_current_color()
            backdrop = self.plugin.get_backdrop_color()

            # Сбрасываем ключи темы и выставляем наши цвета
            try:
                rp2.setColors(backdrop, backdrop, color, color)
            except Exception:
                pass

            # Настраиваем circlePaint подложки
            if self.plugin.get_setting("custom_backdrop", True):
                try:
                    cp = rp2.circlePaint
                except Exception:
                    cp = get_private_field(rp2, "circlePaint")
                if cp is not None:
                    cp.setColor(backdrop)

            # Настраиваем paint внутри MediaActionDrawable
            try:
                mad = rp2.mediaActionDrawable
            except Exception:
                mad = get_private_field(rp2, "mediaActionDrawable")
            if mad is not None:
                self.plugin.tune_media_action_drawable(mad, color)

        except Exception:
            pass


class RadialProgress2SetColorKeysHook(MethodHook):
    """
    Перехватывает попытки Telegram установить ключи темы через setColorKeys.
    Заменяет все ключи на -1, вынуждая Telegram использовать прямые значения цветов.
    """

    def __init__(self, plugin: "BunkerNeonLoaderPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.is_enabled():
            return
        try:
            if param.args is not None and len(param.args) >= 4:
                param.args[0] = -1
                param.args[1] = -1
                param.args[2] = -1
                param.args[3] = -1
        except Exception:
            pass


class RadialProgress2SetColorsHook(MethodHook):
    """Перехватывает явные вызовы setColors."""

    def __init__(self, plugin: "BunkerNeonLoaderPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.is_enabled():
            return
        try:
            color = self.plugin.get_current_color()
            backdrop = self.plugin.get_backdrop_color()
            if param.args is not None and len(param.args) >= 4:
                param.args[0] = backdrop
                param.args[1] = backdrop
                param.args[2] = color
                param.args[3] = color
        except Exception:
            pass


