import math
import time
from typing import Any, List, Optional

# Android SDK & Java bridge
from android.graphics import Color, Paint
from android.os import SystemClock

from android_utils import log, run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from java import jarray

from org.telegram.messenger import AndroidUtilities
from ui.settings import Divider, Header, Selector, Switch, Text

__id__ = "bunker_neon_loader"
__name__ = "Bunker Neon Loader 💫"
__description__ = (
    "Кастомный лоадер и спиннер загрузки медиа (фото, видео, кружочки) в стиле "
    "Неон, RGB-Радуга, iOS Minimal, Sunset и Cyberpunk с эффектом свечения."
)
