# ==============================================================================
# ГЛАВНЫЙ КЛАСС ПЛАГИНА
# ==============================================================================

class BunkerNeonLoaderPlugin(BasePlugin):
    """Основной класс плагина Bunker Neon Loader."""

    STYLE_RGB_RAINBOW = 0
    STYLE_NEON_CYAN = 1
    STYLE_IOS_MINIMAL = 2
    STYLE_SUNSET_FIRE = 3
    STYLE_EMERALD_MATRIX = 4
    STYLE_PURPLE_VELVET = 5
    STYLE_ELECTRIC_GOLD = 6

    def __init__(self):
        super().__init__()
        self._hooks = []
        self._alive = False

    def is_enabled(self) -> bool:
        return bool(self._alive and self.get_setting("enabled", True))

    def on_plugin_load(self):
        self._alive = True
        _log(f"Bunker Neon Loader v{__version__} loading hooks...")

        # 1. Хуки RadialProgress2 (ChatMessageCell)
        try:
            rp2_cls = find_class("org.telegram.ui.Components.RadialProgress2")
            if rp2_cls is not None:
                h_draw = self.hook_all_methods(rp2_cls, "draw", RadialProgress2DrawHook(self))
                if h_draw:
                    self._hooks.extend(h_draw)

                h_set_keys = self.hook_all_methods(rp2_cls, "setColorKeys", RadialProgress2SetColorKeysHook(self))
                if h_set_keys:
                    self._hooks.extend(h_set_keys)

                h_set_colors = self.hook_all_methods(rp2_cls, "setColors", RadialProgress2SetColorsHook(self))
                if h_set_colors:
                    self._hooks.extend(h_set_colors)

                _log("RadialProgress2 hooked successfully")
        except Exception as e:
            _log(f"Failed to hook RadialProgress2: {e}")

        # 2. Хуки MediaActionDrawable (отрисовка дуги и иконок)
        try:
            mad_cls = find_class("org.telegram.ui.Components.MediaActionDrawable")
            if mad_cls is not None:
                h_draw = self.hook_all_methods(mad_cls, "draw", MediaActionDrawableDrawHook(self))
                if h_draw:
                    self._hooks.extend(h_draw)

                h_color = self.hook_all_methods(mad_cls, "setColor", MediaActionDrawableSetColorHook(self))
                if h_color:
                    self._hooks.extend(h_color)

                h_back = self.hook_all_methods(mad_cls, "setBackColor", MediaActionDrawableSetBackColorHook(self))
                if h_back:
                    self._hooks.extend(h_back)

                _log("MediaActionDrawable hooked successfully")
        except Exception as e:
            _log(f"Failed to hook MediaActionDrawable: {e}")

        # 3. Хуки RadialProgressView (PhotoViewer и современные лоадеры)
        try:
            rpv_cls = find_class("org.telegram.ui.Components.RadialProgressView")
            if rpv_cls is not None:
                h_draw1 = self.hook_all_methods(rpv_cls, "onDraw", RadialProgressViewDrawHook(self))
                if h_draw1:
                    self._hooks.extend(h_draw1)

                h_draw2 = self.hook_all_methods(rpv_cls, "draw", RadialProgressViewDrawHook(self))
                if h_draw2:
                    self._hooks.extend(h_draw2)

                h_color = self.hook_all_methods(rpv_cls, "setProgressColor", RadialProgressViewSetColorHook(self))
                if h_color:
                    self._hooks.extend(h_color)

                _log("RadialProgressView hooked successfully")
        except Exception as e:
            _log(f"Failed to hook RadialProgressView: {e}")

        # 4. Хуки RadialProgress (классический для документов и аудио)
        try:
            rp_cls = find_class("org.telegram.ui.Components.RadialProgress")
            if rp_cls is not None:
                h_draw = self.hook_all_methods(rp_cls, "draw", RadialProgressDrawHook(self))
                if h_draw:
                    self._hooks.extend(h_draw)

                h_color = self.hook_all_methods(rp_cls, "setProgressColor", RadialProgressSetColorHook(self))
                if h_color:
                    self._hooks.extend(h_color)

                _log("RadialProgress hooked successfully")
        except Exception as e:
            _log(f"Failed to hook RadialProgress: {e}")

        # Фоновая проверка обновлений
        if self.get_setting("auto_update", True):
            def delayed_check():
                time.sleep(2.5)
                try:
                    self._check_and_apply_update(manual=False)
                except Exception as ex:
                    _log(f"Auto-update check error: {ex}")

            threading.Thread(target=delayed_check, daemon=True).start()

        _log(f"Bunker Neon Loader v{__version__} loaded successfully! 🔥")

    def on_plugin_unload(self):
        self._alive = False
        try:
            self.unhook_all()
        except Exception:
            pass
        self._hooks.clear()
        _log("Bunker Neon Loader unloaded")

    def get_current_color(self) -> int:
        """Вычисляет текущий цвет спиннера на основе выбранного стиля и тайминга."""
        style = self.get_setting("style", self.STYLE_RGB_RAINBOW)
        now = SystemClock.uptimeMillis()

        if style == self.STYLE_RGB_RAINBOW:
            # Плавная RGB-радуга: полный круг спектра за 3.6 секунды
            hue = float((now // 10) % 360)
            return _hsv_to_argb(hue, 0.95, 1.0)

        elif style == self.STYLE_NEON_CYAN:
            # Неоновый Киберпанк Cyan
            return _to_signed_32(0xFF00F0FF)

        elif style == self.STYLE_IOS_MINIMAL:
            # Чистый серебристо-белый в стиле iOS
            return _to_signed_32(0xFFFFFFFF)

        elif style == self.STYLE_SUNSET_FIRE:
            # Огненный закат: волна от рубинового к янтарному
            wave = 0.5 + 0.5 * math.sin(now / 320.0)
            hue = float(10.0 + 38.0 * wave)
            return _hsv_to_argb(hue, 0.95, 1.0)

        elif style == self.STYLE_EMERALD_MATRIX:
            # Кибер-изумруд Матрицы
            return _to_signed_32(0xFF00FF88)

        elif style == self.STYLE_PURPLE_VELVET:
            # Неоновый фиолетовый Аметист
            return _to_signed_32(0xFFBF5AF2)

        elif style == self.STYLE_ELECTRIC_GOLD:
            # Электрический золотой янтарь
            return _to_signed_32(0xFFFFD60A)

        return _to_signed_32(0xFF00F0FF)

    def get_backdrop_color(self) -> int:
        """Возвращает цвет подложки кружка загрузки."""
        if not self.get_setting("custom_backdrop", True):
            return _to_signed_32(0x60000000)

        style = self.get_setting("style", self.STYLE_RGB_RAINBOW)

        if style == self.STYLE_IOS_MINIMAL:
            # Полупрозрачное матовое стекло iOS (30% черный)
            return _to_signed_32(0x45000000)
        elif style == self.STYLE_NEON_CYAN:
            # Глубокий темный сине-черный OLED фон
            return _to_signed_32(0xD0050B14)
        elif style == self.STYLE_EMERALD_MATRIX:
            # Глубокий темный изумрудно-черный фон
            return _to_signed_32(0xD0020F06)
        elif style == self.STYLE_PURPLE_VELVET:
            # Глубокий темный фиолетово-черный фон
            return _to_signed_32(0xD012041A)
        elif style == self.STYLE_SUNSET_FIRE:
            # Глубокий темный закатно-черный фон
            return _to_signed_32(0xD01A0704)

        # Для RGB-радуги и остальных: высококонтрастный 75% OLED черный
        return _to_signed_32(0xBF000000)

    def get_stroke_width(self) -> float:
        """Возвращает толщину линии спиннера."""
        stroke_idx = self.get_setting("stroke_width", 1)
        style = self.get_setting("style", self.STYLE_RGB_RAINBOW)

        # Тонкий профиль для iOS стиля
        if style == self.STYLE_IOS_MINIMAL and stroke_idx == 1:
            return float(AndroidUtilities.dp(1.8))

        if stroke_idx == 0:
            return float(AndroidUtilities.dp(1.8))  # Тонкий
        elif stroke_idx == 2:
            return float(AndroidUtilities.dp(4.2))  # Жирный неоновый
        return float(AndroidUtilities.dp(3.0))      # Стандарт

    def tune_media_action_drawable(self, mad: Any, color: int):
        """Настраивает Paint объекты внутри MediaActionDrawable."""
        try:
            stroke_width = self.get_stroke_width()
            glow = bool(self.get_setting("glow_enabled", True))
            pulse = bool(self.get_setting("pulse_enabled", True))
            colorize_icon = bool(self.get_setting("colorize_icon", True))

            # 1. Дуга спиннера (paint)
            try:
                paint = mad.paint
            except Exception:
                paint = get_private_field(mad, "paint")

            if paint is not None:
                paint.setStyle(Paint.Style.STROKE)
                paint.setStrokeCap(Paint.Cap.ROUND)
                paint.setStrokeWidth(stroke_width)
                paint.setColor(color)
                paint.setShader(None)  # Убираем стандартные градиенты Telegram

                if glow:
                    paint.setShadowLayer(float(AndroidUtilities.dp(4.5)), 0.0, 0.0, color)
                else:
                    paint.clearShadowLayer()

                if pulse:
                    now = SystemClock.uptimeMillis()
                    p = 0.86 + 0.14 * math.sin(now / 220.0)
                    paint.setAlpha(int(255 * p))

            # 2. Иконка внутри (стрелочка скачивания/выгрузки, пауза, крестик)
            if colorize_icon:
                try:
                    paint2 = mad.paint2
                except Exception:
                    paint2 = get_private_field(mad, "paint2")
                if paint2 is not None:
                    paint2.setColor(color)

                try:
                    paint3 = get_private_field(mad, "paint3")
                    if paint3 is not None:
                        paint3.setColor(color)
                except Exception:
                    pass

                try:
                    text_paint = get_private_field(mad, "textPaint")
                    if text_paint is not None:
                        text_paint.setColor(color)
                except Exception:
                    pass

        except Exception:
            pass

    def _copy_repo_url(self):
        """Копирует ссылку на репозиторий плагинов Бункера в буфер обмена."""
        try:
            ctx_app = ApplicationLoader.applicationContext
            cm = ctx_app.getSystemService(Context.CLIPBOARD_SERVICE)
            clip = ClipData.newPlainText("repo_url", REPO_URL)
            cm.setPrimaryClip(clip)
            safe_notify("Ссылка на репозиторий скопирована в буфер обмена! 🐈‍⬛")
        except Exception as e:
            safe_notify(f"Ошибка копирования: {e}")

    def _check_and_apply_update(self, manual: bool = False):
        """Проверяет обновления на GitHub и автоматически обновляет файл плагина."""
        try:
            if manual:
                safe_notify("🔍 Проверяю наличие обновлений Bunker Loader...")

            remote_code = None
            urls = [UPDATE_URL_MIRROR, UPDATE_URL_GITHUB]
            for url in urls:
                try:
                    req = urllib.request.Request(
                        url,
                        headers={"User-Agent": "BunkerNeonLoaderPlugin/1.2"}
                    )
                    with urllib.request.urlopen(req, timeout=12.0) as resp:
                        if resp.getcode() == 200:
                            data = resp.read().decode("utf-8", errors="replace")
                            if "__version__" in data and "BunkerNeonLoaderPlugin" in data:
                                remote_code = data
                                break
                except Exception as ex:
                    _log(f"Update fetch failed from {url}: {ex}")
                    continue

            if not remote_code:
                if manual:
                    safe_notify("❌ Не удалось проверить обновления. Проверьте интернет.")
                return

            ver_match = re.search(r'__version__\s*=\s*["\']([^"\']+)["\']', remote_code)
            if not ver_match:
                if manual:
                    safe_notify("⚠️ Ошибка формата версии на сервере.")
                return

            remote_ver = ver_match.group(1).strip()
            local_ver = __version__.strip()

            def parse_ver(v_str: str) -> Tuple[int, ...]:
                parts = []
                for p in re.findall(r"\d+", v_str):
                    try:
                        parts.append(int(p))
                    except Exception:
                        pass
                return tuple(parts)

            if parse_ver(remote_ver) <= parse_ver(local_ver):
                if manual:
                    safe_notify(f"У вас самая свежая версия (v{local_ver}) ✅")
                return

            # Ищем файл плагина для перезаписи
            target_file = None
            if globals().get("__file__") and os.path.isfile(__file__):
                target_file = __file__

            if not target_file:
                try:
                    ctx_app = ApplicationLoader.applicationContext
                    if ctx_app:
                        app_files_dir = ctx_app.getFilesDir().getAbsolutePath()
                        p_path = os.path.join(app_files_dir, "plugins", f"{__id__}.plugin")
                        if os.path.exists(p_path):
                            target_file = p_path
                except Exception:
                    pass

            if not target_file:
                for cand_dir in [
                    "/data/user/0/app.nimarkogram.messenger/files/plugins",
                    "/data/data/app.nimarkogram.messenger/files/plugins",
                    "/data/user/0/com.exteragram.messenger/files/plugins",
                    "/data/data/com.exteragram.messenger/files/plugins",
                ]:
                    cand_path = os.path.join(cand_dir, f"{__id__}.plugin")
                    if os.path.exists(cand_path):
                        target_file = cand_path
                        break

            if target_file and os.path.exists(target_file):
                try:
                    with open(target_file, "w", encoding="utf-8") as f:
                        f.write(remote_code)
                    _log(f"Плагин успешно перезаписан: {target_file} -> v{remote_ver}")
                    safe_notify(f"🎉 Bunker Loader обновлён до v{remote_ver}! Перезапустите Telegram.")
                    return
                except Exception as wr_err:
                    _log(f"Ошибка перезаписи {target_file}: {wr_err}")

            if manual:
                safe_notify(f"Доступна новая v{remote_ver}! Скачайте из канала Бункера.")

        except Exception as exc:
            _log(f"Update error: {exc}")
            if manual:
                safe_notify(f"Ошибка обновления: {exc}")

    def create_settings(self) -> List[Any]:
        """Формирует меню настроек плагина в NimarkoGram / ExteraGram / AyuGram."""
        return [
            Header(text="Визуальный стиль лоадера"),
            Switch(
                key="enabled",
                text="Включить кастомный лоадер",
                subtext="Заменяет стандартный серый кружок со стрелочкой на дизайнерский спиннер",
                default=True,
                icon="msg_round_attachement",
            ),
            Selector(
                key="style",
                text="Тема лоадера",
                items=[
                    "🌈 RGB-Радуга (Плавные переливы)",
                    "⚡ Неоновый Киберпанк (Cyber Cyan)",
                    "🍏 iOS Минимализм (Тонкий серебристый)",
                    "🌅 Огненный закат (Sunset Gradient)",
                    "💚 Изумруд Matrix (Neon Emerald)",
                    "💜 Аметист Cyber (Neon Purple)",
                    "💛 Золотой янтарь (Electric Gold)",
                ],
                default=self.STYLE_RGB_RAINBOW,
                icon="msg_colors",
            ),
            Selector(
                key="stroke_width",
                text="Толщина спиннера",
                items=[
                    "Тонкий (1.8 dp — стиль iOS)",
                    "Стандартный (3.0 dp)",
                    "Жирный неоновый (4.2 dp — Cyber)",
                ],
                default=1,
                icon="msg_customize",
            ),
            Divider(),
            Header(text="Эффекты анимации"),
            Switch(
                key="glow_enabled",
                text="Неоновое свечение (Glow)",
                subtext="Мягкий неоновый ореол вокруг индикатора загрузки",
                default=True,
                icon="msg_premium_stars",
            ),
            Switch(
                key="pulse_enabled",
                text="Пульсация при ожидании",
                subtext="Плавное дыхание кольца загрузки при передаче данных",
                default=True,
                icon="msg_motion",
            ),
            Switch(
                key="custom_backdrop",
                text="OLED-подложка",
                subtext="Стильный затемнённый высококонтрастный фон вместо стандартного серого",
                default=True,
                icon="msg_theme",
            ),
            Switch(
                key="colorize_icon",
                text="Окрашивать иконку (стрелочку/паузу)",
                subtext="Применяет цвет спиннера к внутренней стрелке, крестику и процентам",
                default=True,
                icon="msg_download",
            ),
            Divider(),
            Header(text="Обновления плагина"),
            Switch(
                key="auto_update",
                text="Автообновление",
                subtext="Автоматически загружать новые версии и стили с GitHub Бункера",
                default=True,
                icon="msg_retry",
            ),
            Text(
                text="Проверить обновления сейчас",
                subtext=f"Текущая версия: v{__version__}",
                icon="msg_download",
                accent=True,
                on_click=lambda _: threading.Thread(
                    target=self._check_and_apply_update, args=(True,), daemon=True
                ).start(),
            ),
            Text(
                text="Скопировать ссылку на репозиторий",
                subtext="Добавьте в Настройки Telegram -> Плагины -> Репозитории",
                icon="msg_link",
                on_click=lambda _: self._copy_repo_url(),
            ),
            Divider(),
            Header(text="О плагине"),
            Text(
                text="Bunker Neon Loader v1.2.0",
                subtext="Бункер Кота (@BUNKER_K0TA / @k0tlux)",
                icon="msg_info",
            ),
        ]
