class MediaActionDrawableDrawHook(MethodHook):
    """
    Перехватывает MediaActionDrawable.draw(Canvas).
    Срабатывает непосредственно перед вызовом canvas.drawArc(...) и canvas.drawLine.
    Гарантирует толщину, цвет, круглые концы и неоновое свечение.
    """

    def __init__(self, plugin: "BunkerNeonLoaderPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.is_enabled():
            return
        try:
            mad = param.thisObject
            if mad is None:
                return
            color = self.plugin.get_current_color()
            self.plugin.tune_media_action_drawable(mad, color)
        except Exception:
            pass


class MediaActionDrawableSetColorHook(MethodHook):
    """Перехватывает MediaActionDrawable.setColor(int) и подменяет аргумент."""

    def __init__(self, plugin: "BunkerNeonLoaderPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.is_enabled():
            return
        try:
            param.args[0] = self.plugin.get_current_color()
        except Exception:
            pass


class MediaActionDrawableSetBackColorHook(MethodHook):
    """Перехватывает MediaActionDrawable.setBackColor(int) и подменяет аргумент."""

    def __init__(self, plugin: "BunkerNeonLoaderPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.is_enabled():
            return
        try:
            param.args[0] = self.plugin.get_backdrop_color()
        except Exception:
            pass


# ==============================================================================
# ХУКИ ДЛЯ RadialProgressView (Полноэкранный просмотрщик PhotoViewer и диалоги)
# ==============================================================================

class RadialProgressViewDrawHook(MethodHook):
    """Перехватывает отрисовку современного RadialProgressView (PhotoViewer, профили)."""

    def __init__(self, plugin: "BunkerNeonLoaderPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.is_enabled():
            return
        try:
            rpv = param.thisObject
            if rpv is None:
                return

            color = self.plugin.get_current_color()
            stroke_width = self.plugin.get_stroke_width()
            glow = bool(self.plugin.get_setting("glow_enabled", True))

            try:
                paint = rpv.progressPaint
            except Exception:
                paint = get_private_field(rpv, "progressPaint")

            if paint is not None:
                paint.setColor(color)
                paint.setStrokeCap(Paint.Cap.ROUND)
                paint.setStrokeWidth(stroke_width)
                if glow:
                    paint.setShadowLayer(float(AndroidUtilities.dp(4.5)), 0.0, 0.0, color)
                else:
                    paint.clearShadowLayer()

        except Exception:
            pass


class RadialProgressViewSetColorHook(MethodHook):
    """Перехватывает RadialProgressView.setProgressColor(int)."""

    def __init__(self, plugin: "BunkerNeonLoaderPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.is_enabled():
            return
        try:
            param.args[0] = self.plugin.get_current_color()
        except Exception:
            pass


